<!-- Side panel toggle handled via class -->

<script>
(function(){
  var role = 'teacher';
  var currentView = 'market';

  /* ==== Role separation CSS rules applied dynamically ==== */
  function applyRoleTag(){
    // We rely on body attribute styling? Instead toggle per-element.
    document.querySelectorAll('[data-ro]').forEach(function(el){
      var show = (el.dataset.ro === role);
      el.style.display = show ? '' : 'none';
    });
    document.getElementById('avat').textContent = (role==='teacher')?'师':'生';
  }

  /* ==== View switching ==== */
  var views = ['market','skill','chat','library','lesson','question','services'];
  function switchView(v){
    currentView = v;
    views.forEach(function(id){
      var el = document.getElementById('view-'+id);
      if(el) el.classList.toggle('active', id===v);
    });
    document.querySelectorAll('.snav[data-view]').forEach(function(n){
      n.classList.toggle('active', n.dataset.view===v);
    });
    document.querySelectorAll('.proj-leaf[data-view]').forEach(function(n){
      n.classList.toggle('active', n.dataset.view===v);
    });
    var crumbText = {market:'Skill 市场',skill:'Skill 详情',chat:'新对话',library:'教材库',lesson:'我的课程',question:'我的题库',services:'MCP 服务'}[v]||'主界面';
    document.getElementById('crumb').innerHTML = '<b>'+crumbText+'</b>';
    if(v==='chat'){ updateGreeting(); }
  }

  document.querySelectorAll('.snav[data-view]').forEach(function(n){
    n.addEventListener('click', function(){ switchView(n.dataset.view); });
  });
  document.querySelectorAll('.proj-leaf[data-view]').forEach(function(n){
    n.addEventListener('click', function(){ switchView(n.dataset.view); });
  });
  document.getElementById('newChatBtn').addEventListener('click', function(){
    switchView('chat');
    doNewChat();
  });

  /* ==== Role switch ==== */
  document.querySelectorAll('#roleSeg button').forEach(function(b){
    b.addEventListener('click', function(){
      role = b.dataset.role;
      document.querySelectorAll('#roleSeg button').forEach(function(x){ x.classList.toggle('active', x===b); });
      applyRoleTag();
      // role-specific copy
      if(role==='teacher'){
        document.getElementById('homeSub').textContent = '你负责想象，我负责写 · 优先依据教材回答';
      } else {
        document.getElementById('homeSub').textContent = '我是你的 AI 学习助手，可以答疑、梳理知识点、分析错题或出练习。';
      }
      buildChips();
      updateGreeting();
      // guard: if a student lands on teacher view, redirect
      if(role==='student' && (currentView==='library')) switchView('chat');
      if(role==='teacher' && (currentView==='lesson')) switchView('chat');
    });
  });

  /* ==== Greeting (time based) ==== */
  function greetingText(){
    var h = new Date().getHours();
    var g = h<6?'夜深了':(h<12?'早上好':(h<18?'下午好':'晚上好'));
    return g + '，' + (role==='teacher'?'王老师':'同学');
  }
  function updateGreeting(){
    document.getElementById('greet').textContent = greetingText();
  }

  /* ==== Skill market data ==== */
  var marketData = [
    {cat:'教学辅助', desc:'编写、理解、审阅与维护教学方案与教案。', skills:[
      {icon:'教', title:'教案设计规范', desc:'减少默认假设、过度工程化，降低修改过的教案，确保贴近教材与学情。'},
      {icon:'K', title:'教案精简器', desc:'简化并精炼教案：提升清晰度、一致性与可维护性，严格控制篇幅。'},
      {icon:'C', title:'知识图谱设计', desc:'以课程模块为单元，梳理并可视化章节结构，辅助教学设计。'},
      {icon:'G', title:'教材结构图谱', desc:'用本地教材图谱快速理解章节、知识点、例题与练习之间的关联。'},
      {icon:'D', title:'错题诊断', desc:'面向疑难错题与知识盲区，定位错误原因，给出针对性讲评。'},
      {icon:'P', title:'教案审查', desc:'仅在你明确选择时审查教案与差异，并给出可删减建议。'},
      {icon:'P', title:'教案复核', desc:'用 LSP 语法、引用、诊断与符号辅助，检查教案结构一致性。'},
      {icon:'S', title:'试题解析', desc:'给出结构化解析，覆盖知识点、难度与错因分析。'},
      {icon:'U', title:'Understand Anything', desc:'用本地图谱理解任意教案、题目或教学文档结构。'},
    ]},
    {cat:'UI 美化', desc:'动效、交互和界面质量提升。', skills:[
      {icon:'E', title:'板书动效', desc:'高保真课堂板书动效还原，支持逐帧演示与页面切换。'},
      {icon:'C', title:'课堂画板', desc:'制作可交互的几何画板，支持拖拽、翻转与组合演示。'},
      {icon:'L', title:'Liquid Glass 反应', desc:'制作高质量润色课件，支持教学演示与交互设计。'},
    ]}
  ];

  var checkSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4"><path d="M20 6L9 17l-5-5"/></svg>';

  function buildMarket(filter){
    var html = '';
    marketData.forEach(function(cat){
      var skills = cat.skills.filter(function(s){ return !filter || s.title.indexOf(filter)>-1; });
      if(!skills.length) return;
      html += '<div class="mk-cat"><div class="mk-cat-name">'+cat.cat+'</div><div class="mk-cat-desc">'+cat.desc+'</div>';
      html += '<div class="mk-grid">';
      skills.forEach(function(s){
        html += '<button class="skill-card" data-skill="'+s.title+'">'+
          '<span class="check-orb">'+checkSvg+'</span>'+
          '<div class="sc-top"><div class="skill-icon">'+s.icon+'</div><div class="sc-title">'+s.title+'</div></div>'+
          '<div class="sc-desc">'+s.desc+'</div></button>';
      });
      html += '</div></div>';
    });
    document.getElementById('marketBody').innerHTML = html || '<div class="mk-cat"><div class="mk-cat-desc">没有匹配的 Skill。</div></div>';
    document.querySelectorAll('.skill-card').forEach(function(c){
      c.addEventListener('click', function(){ openSkill(c.dataset.skill); });
    });
  }

  /* ==== Skill detail ==== */
  function openSkill(title){
    var s=null, cat='';
    marketData.forEach(function(c){ c.skills.forEach(function(x){ if(x.title===title){s=x;cat=c.cat;} }); });
    if(!s) return;
    var modules = [
      {icon:'H', name: s.title+' CLI', desc:'内部配套：脚手架、检查、预览、渲染、转录与指令集', code:'teaching-cli'},
      {icon:'G', name:'GSAP 支持', desc:'内部配套：可寻址动效、时间线、缓动与性能规则', code:'gsap'},
      {icon:'R', name:s.title+' Registry', desc:'内部配套：发现、安装并接入教学资源区块', code:'teaching-registry'},
      {icon:'W', name:'教案转课件', desc:'内部配套：将教案抓取、脚本、分镜、配音与构建成完整教学流程', code:'lesson-to-slides'},
    ];
    var html = '<button class="sd-back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>返回 Skill 市场</button>';
    html += '<div class="sd-hero"><div class="sd-hero-icon"><svg viewBox="0 0 52 52" fill="none"><rect x="6" y="6" width="40" height="40" rx="14" fill="#3b82f6"/><path d="M18 20h16M18 28h16M18 36h10" stroke="#fff" stroke-width="3" stroke-linecap="round"/></svg></div>'+
      '<div><div class="sd-tags"><span class="tag">'+cat+'</span><span class="tag installed">已安装</span></div>'+
      '<div class="sd-title">'+s.title+'</div>'+
      '<div class="sd-desc">'+s.desc+'。用于创建、检查、预览并渲染教学方案，支持字幕、配音、音频响应与教案转课件。</div>'+
      '<div class="sd-author">Yan Agent · 教育版</div></div></div>';
    html += '<div class="sd-sec"><div class="sd-sec-title">包含的 Skill</div><div class="sd-sec-desc">以下模块会随该能力一起提供。</div><div class="sd-list">';
    modules.forEach(function(m){
      html += '<div class="sd-row"><div class="r-icon">'+m.icon+'</div><div class="r-main"><div class="r-name">'+m.name+'</div><div class="r-desc">'+m.desc+'</div><div class="s" style="font-size:11.5px;color:var(--ink-400);margin-top:2px">'+m.code+'</div></div><span class="r-tag">已安装</span></div>';
    });
    html += '</div></div>';
    document.getElementById('skillDetail').innerHTML = html;
    document.querySelector('.sd-back').addEventListener('click', function(){ switchView('market'); });
    switchView('skill');
  }

  /* ==== Side panel toggle ==== */
  document.getElementById('btnSidePanel').addEventListener('click', function(){
    document.getElementById('sidePanel').style.display = document.getElementById('sidePanel').style.display==='none'?'':'none';
  });

  /* ==== Home chips (role aware, click to fill) ==== */
  function buildChips(){
    var chips = (role==='teacher')
      ? ['生成教案','出一组题','总结本章','教材分析']
      : ['教材问答','总结本章','错题分析','再练一组'];
    var html = '';
    chips.forEach(function(c){ html += '<button class="hchip" data-c="'+c+'">'+c+'</button>'; });
    document.getElementById('homeChips').innerHTML = html;
    document.querySelectorAll('.hchip').forEach(function(ch){
      ch.addEventListener('click', function(){
        document.getElementById('chatInput').value = '“'+ch.dataset.c+'” 相关的教学任务';
        document.getElementById('chatInput').focus();
      });
    });
  }

  /* ==== Chat send/stop — 真实后端对接 (2026-09-10, 保留原视觉) ==== */
  var inConversation = false;
  var chatLive = document.getElementById('chatLive');
  var msgBox = document.getElementById('chatMsgBox');
  var home = document.getElementById('home');
  var CUR = null, BUSY = false, lastQ = '', thinkEl = null;

  function escHtml(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function mdLight(s){
    var t = escHtml(s);
    t = t.replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>');
    t = t.replace(/^### (.*)$/gm, '<div style="font-size:15px;font-weight:600;margin:8px 0 4px">$1</div>');
    t = t.replace(/^## (.*)$/gm, '<div style="font-size:16px;font-weight:600;margin:10px 0 4px">$1</div>');
    t = t.replace(/^# (.*)$/gm, '<div style="font-size:17px;font-weight:700;margin:10px 0 4px">$1</div>');
    t = t.replace(/^- (.*)$/gm, '<div style="padding-left:14px">• $1</div>');
    t = t.replace(/^&gt; (.*)$/gm, '<div style="border-left:3px solid var(--line-strong);padding-left:10px;color:var(--ink-600)">$1</div>');
    t = t.replace(/\n/g, '<br>');
    return t;
  }
  function scrollChat(){ msgBox.scrollTop = msgBox.scrollHeight; }
  function bubbleUser(text){
    var m = document.createElement('div');
    m.style.cssText='display:flex;gap:12px;align-items:flex-start';
    m.innerHTML = '<div class="avt" style="background:var(--bg-soft);color:var(--ink-800)">'+(role==='teacher'?'师':'生')+'</div><div style="flex:1;background:var(--bg-soft);border-radius:12px;padding:12px 16px;font-size:14px;line-height:1.65"></div>';
    m.querySelector('div[style*="flex:1"]').textContent = text;
    msgBox.appendChild(m); scrollChat();
  }
  function bubbleAiStart(){
    var ai = document.createElement('div');
    ai.style.cssText='display:flex;gap:12px;align-items:flex-start';
    var body = document.createElement('div');
    body.style.cssText='flex:1;min-width:0;font-size:14px;line-height:1.7;word-break:break-word';
    ai.appendChild(body);
    var av = document.createElement('div'); av.className='avt'; av.style.background='var(--dark)'; av.textContent='AI';
    ai.insertBefore(av, body);
    msgBox.appendChild(ai); scrollChat();
    return body;
  }
  function showThink(text){
    if(!thinkEl){
      thinkEl = document.createElement('div');
      thinkEl.style.cssText='display:flex;gap:12px;align-items:flex-start';
      var av = document.createElement('div'); av.className='avt'; av.style.background='var(--dark)'; av.textContent='AI';
      var inner = document.createElement('div'); inner.style.flex='1'; inner.className='thinkInner';
      thinkEl.appendChild(av); thinkEl.appendChild(inner);
      msgBox.appendChild(thinkEl);
    }
    thinkEl.querySelector('.thinkInner').innerHTML = '<span class="st-pill amber"><span class="dot"></span>'+escHtml(text||'正在思考…')+'</span>';
    scrollChat();
  }
  function hideThink(){ if(thinkEl){ thinkEl.remove(); thinkEl=null; } }
  function showErr(text){
    hideThink();
    var e = document.createElement('div');
    e.style.cssText='display:flex;gap:12px;align-items:flex-start';
    e.innerHTML = '<div class="avt" style="background:#dc2626;color:#fff">!</div><div style="flex:1;color:#b91c1c;background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:10px 14px;font-size:13px">'+escHtml(text)+'</div>';
    msgBox.appendChild(e); scrollChat();
  }
  function addCites(el, cites){
    if(!cites || !cites.length) return;
    var row = document.createElement('div');
    row.style.cssText='margin-top:10px;display:flex;gap:6px;flex-wrap:wrap';
    cites.forEach(function(c,i){
      var sp = document.createElement('span'); sp.className='st-pill green';
      sp.innerHTML = '<sup>['+(i+1)+']</sup> '+escHtml((c.book||'')+' '+(c.chapter||'')+(c.section?' '+c.section:'')+' P'+(c.page||'?'));
      row.appendChild(sp);
    });
    el.appendChild(row);
  }
  function addActions(el, raw){
    var row = document.createElement('div');
    row.style.cssText='margin-top:10px;display:flex;gap:6px;flex-wrap:wrap';
    var cp = document.createElement('button'); cp.className='pill-btn'; cp.textContent='复制';
    cp.onclick = function(){ if(navigator.clipboard) navigator.clipboard.writeText(raw).then(function(){ cp.textContent='已复制'; setTimeout(function(){ cp.textContent='复制'; },1500); }); };
    var rg = document.createElement('button'); rg.className='pill-btn'; rg.textContent='重新生成';
    rg.onclick = function(){ if(BUSY || !lastQ) return; sendText(lastQ); };
    row.appendChild(cp); row.appendChild(rg);
    el.appendChild(row);
  }
  function resetToHome(){
    inConversation = false;
    home.classList.remove('hidden');
    chatLive.classList.add('hidden');
  }
  function enterConversation(){
    if(!inConversation){ inConversation = true; home.classList.add('hidden'); chatLive.classList.remove('hidden'); }
  }
  function loadHistory(sid){
    fetch('/api/session/get',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:sid})})
      .then(function(r){ return r.json(); }).then(function(d){
        var msgs = (d && d.messages) || [];
        if(!msgs.length){ resetToHome(); return; }
        enterConversation();
        msgBox.innerHTML='';
        msgs.forEach(function(m){
          var c = (m.content||'').replace(/^【\*{2}.*?\*{2}】\s*/,'');
          if(!c) return;
          if(m.role==='user'){ bubbleUser(c); }
          else { var b = bubbleAiStart(); b.innerHTML = mdLight(c); }
        });
        scrollChat();
      }).catch(function(){ resetToHome(); });
  }
  function buildHistory(){
    var box = document.getElementById('projectBox');
    var count = document.getElementById('projCount');
    if(!box) return;
    fetch('/api/sessions').then(function(r){ return r.json(); }).then(function(d){
      var list = (d && d.list) || [];
      var cur = d && d.current;
      if(count) count.textContent = list.length ? String(list.length) : '';
      if(!list.length){ box.innerHTML=''; return; }
      var html = '<button class="proj-leaf proj-new"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;vertical-align:-2px;margin-right:6px;color:var(--ink-400)"><path d="M12 5v14M5 12h14"/></svg>新对话</button>';
      list.slice(-9).reverse().forEach(function(s){
        html += '<button class="proj-leaf proj-sess'+(s.id===cur?' active':'')+'" data-sid="'+escHtml(s.id)+'">'+escHtml((s.title&&s.title!=='新会话')?s.title:'新对话')+'</button>';
      });
      box.innerHTML = html;
      box.querySelectorAll('.proj-new').forEach(function(b){
        b.addEventListener('click', function(){ if(BUSY) return; doNewChat(); });
      });
      box.querySelectorAll('.proj-sess').forEach(function(b){
        b.addEventListener('click', function(){
          if(BUSY) return;
          var sid = b.dataset.sid;
          CUR = sid;
          box.querySelectorAll('.proj-sess').forEach(function(x){ x.classList.toggle('active', x===b); });
          switchView('chat');
          loadHistory(sid);
        });
      });
    }).catch(function(){});
  }
  function doNewChat(){
    msgBox.innerHTML='';
    CUR = null;
    resetToHome();
    fetch('/api/session/new',{method:'POST'}).then(function(r){return r.json();})
      .then(function(d){ CUR = d.id; buildHistory(); }).catch(function(){});
  }
  var projToggle = document.getElementById('projToggle');
  if(projToggle) projToggle.addEventListener('click', function(){
    var box = document.getElementById('projectBox');
    var open = projToggle.classList.toggle('open');
    if(box) box.style.display = open ? '' : 'none';
  });
  function sendText(val){
    enterConversation();
    bubbleUser(val);
    document.getElementById('chatInput').value='';
    lastQ = val;
    showThink('正在检索教材 · 可取消');
    BUSY = true;
    var doFetch = function(sid){
      return fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({text:val,session_id:sid||CUR||'',preset:'auto',template_id:'default',corpus:'textbook'})})
        .then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.body.getReader(); })
        .then(function(reader){ return streamRead(reader); });
    };
    var p = CUR ? doFetch(CUR) : fetch('/api/session/new',{method:'POST'}).then(function(r){return r.json();})
        .then(function(d){ CUR = d.id; return doFetch(CUR); });
    p.catch(function(e){ hideThink(); showErr('网络错误：'+(e.message||'连接失败')+'。服务是否在运行？'); BUSY=false; });
  }
  function bindComposer(inputId, orbId){
    var input = document.getElementById(inputId);
    var orb = document.getElementById(orbId);
    var fire = function(){ if(BUSY) return; var v=(input.value||'').trim(); if(!v) return; sendText(v); input.value=''; };
    if(orb) orb.addEventListener('click', fire);
    if(input) input.addEventListener('keydown', function(e){
      if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); fire(); }
    });
  }
  bindComposer('chatInput','sendOrb');
  bindComposer('chatInput2','sendOrb2');
  function streamRead(reader){
    hideThink();
    var bodyEl = bubbleAiStart();
    var dec = new TextDecoder(), buf='', lastEvt=Date.now(), raw='';
    var wt = setInterval(function(){
      if(Date.now()-lastEvt>8000){ showThink('仍在思考，已等待 '+Math.round((Date.now()-lastEvt)/1000)+'s…'); }
    },3000);
    function pump(){
      return reader.read().then(function(res){
        if(res.done){ clearInterval(wt); BUSY=false; return; }
        buf += dec.decode(res.value,{stream:true}); lastEvt=Date.now();
        var i;
        while((i=buf.indexOf('\n\n'))>=0){
          var line = buf.slice(0,i); buf = buf.slice(i+2);
          if(line.indexOf('data: ')===0){
            try { var ev = JSON.parse(line.slice(6)); handleEv(ev); } catch(e){}
          }
        }
        return pump();
      });
    }
    function handleEv(ev){
      var t = ev.t;
      if(t==='session'){ CUR = ev.id; }
      else if(t==='status'){ if(thinkEl) showThink(ev.text||'正在处理…'); }
      else if(t==='d'){ hideThink(); raw += ev.text||''; bodyEl.innerHTML = mdLight(raw); scrollChat(); }
      else if(t==='done'){
        hideThink();
        if(ev.text && ev.text!==raw){ raw = ev.text; bodyEl.innerHTML = mdLight(raw); }
        addCites(bodyEl, ev.citations||[]);
        addActions(bodyEl, raw);
        scrollChat();
        buildHistory();
      }
      else if(t==='error'){ hideThink(); showErr(ev.text||'请求出错'); }
    }
    return pump();
  }

  /* ==== Model selector ==== */
  var models = ['deepseek-v4-pro','deepseek-r1','deepseek-v3'];
  document.getElementById('modelPill').addEventListener('click', function(){
    var i = models.indexOf(document.getElementById('modelName').textContent);
    document.getElementById('modelName').textContent = models[(i+1)%models.length];
  });

  /* ==== Settings modal (常规) ==== */
  var overlay = null, modal = null;
  function openModal(body, wide){
    closeModal();
    overlay = document.createElement('div');
    overlay.className = 'overlay';
    modal = document.createElement('div');
    modal.className = 'modal' + (wide?' m-wide':'');
    modal.innerHTML = body;
    overlay.appendChild(modal);
    overlay.addEventListener('click', function(e){ if(e.target===overlay) closeModal(); });
    document.body.appendChild(overlay);
    wireModal();
  }
  function closeModal(){ if(overlay) overlay.remove(); overlay=null; }
  function wireModal(){
    var cs = modal.querySelectorAll('.m-close');
    cs.forEach(function(c){ c.addEventListener('click', closeModal); });
  }

  /* ==== 常规 settings ==== */
