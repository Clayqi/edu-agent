        '<button class="git-item" data-g="push"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12l16-8-6 16-3-6-7-2z"/></svg><span class="gt">提交或推送</span><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></button>'+
      '</div>';
    document.body.appendChild(gitPop);
    gitPop.querySelectorAll('.git-item').forEach(function(it){
      it.addEventListener('click', function(){
        var g = it.dataset.g;
        gitPop.remove(); gitPop=null;
        if(g==='push'||g==='commit') openCommitModal();
        if(g==='branch') openGitGraph();
      });
    });
    document.addEventListener('click', outsideDismiss);
  }
  function outsideDismiss(e){
    if(gitPop && !gitPop.contains(e.target) && e.target!==document.getElementById('avat')){ gitPop.remove(); gitPop=null; document.removeEventListener('click',outsideDismiss); }
  }

