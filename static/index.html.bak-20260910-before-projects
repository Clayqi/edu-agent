              <div class="lrow"><div class="li"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4H6.5A2.5 2.5 0 0 0 4 6.5v13z"/></svg></div><div class="lm"><div class="t">文件服务</div><div class="s">PDF 上传 / 解析 / 分发</div></div><span class="st-pill green"><span class="dot"></span>已连接</span><div class="side"><button class="pill-btn">配置</button></div></div>
              <div class="lrow"><div class="li"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg></div><div class="lm"><div class="t">用户服务</div><div class="s">角色 / 权限 / 授权管理</div></div><span class="st-pill"><span class="dot"></span>未连接</span><div class="side"><button class="pill-btn dark">连接</button></div></div>
            </div>
          </div>
        </div>

