        </button>
        <button class="snav" data-view="question">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5h6a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/><path d="M9 12h6"/></svg>
          <span data-ro="teacher">我的题库</span><span data-ro="student">我的练习</span>
        </button>
      </div>

      <div class="sec-label">项目</div>
      <div class="side-nav" style="padding-bottom:2px">
