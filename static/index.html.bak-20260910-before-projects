<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>教育 Agent · UnderstandAnything</title>
<style>
:root{
  --ink-900:#1a1a1b; --ink-700:#3f3f46; --ink-600:#52525b; --ink-500:#71717a; --ink-400:#a1a1aa;
  --line:#ececec; --line-strong:#d9d9d9;
  --bg:#ffffff; --bg-soft:#fafafa; --bg-hover:#f4f4f4; --bg-active:#f1f1f0;
  --blue:#3b82f6; --blue-soft:#eff6ff;
  --green:#16a34a; --green-soft:#dcfce7; --green-500:#22c55e;
  --red:#dc2626; --orange:#f97316; --amber:#b45309;
  --dark:#1a1a1b;
  --r-xs:6px; --r-sm:8px; --r-md:10px; --r-lg:14px; --r-xl:18px; --r-pill:999px;
  --shadow-sm:0 1px 2px rgba(0,0,0,.04);
  --shadow-md:0 8px 30px rgba(0,0,0,.10);
  --font:-apple-system,BlinkMacSystemFont,"Segoe UI","Inter","Helvetica Neue","Microsoft YaHei",system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:var(--font);font-size:14px;color:var(--ink-900);background:var(--bg);-webkit-font-smoothing:antialiased;overflow:hidden}
button{font-family:var(--font);cursor:pointer}
button:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
svg{display:block}
.hidden{display:none!important}

/* ===== Window frame / top tabs ===== */
.win{display:flex;flex-direction:column;height:100vh}
.titlebar{display:flex;align-items:center;gap:2px;padding:6px 10px 0;background:#fff;position:relative}
.wtab{display:inline-flex;align-items:center;gap:8px;padding:7px 14px;font-size:13px;color:var(--ink-500);border-radius:8px 8px 0 0;position:relative}
.wtab.active{color:var(--ink-900);font-weight:500;background:var(--bg);border:.5px solid var(--line);border-bottom:none}
.wtab .win-dot{width:14px;height:14px;border-radius:4px;background:#f1f1f0;border:.5px solid var(--line);display:inline-flex;align-items:center;justify-content:center}
.wtab .win-dot span{font-size:9px;color:var(--ink-500)}
.titlebar-spacer{flex:1}
.win-controls{display:flex;align-items:center;gap:4px;padding-right:6px}
.wctl{width:36px;height:32px;border-radius:6px;border:none;background:transparent;color:var(--ink-600);display:inline-flex;align-items:center;justify-content:center}
.wctl:hover{background:var(--bg-hover)}
.wctl.close:hover{background:#e5484d;color:#fff}
.wctl svg{width:14px;height:14px}

/* ===== Shell ===== */
.shell{display:flex;flex:1;min-height:0;background:var(--bg)}
.sidebar{width:252px;flex:none;background:var(--bg);border-right:.5px solid var(--line);display:flex;flex-direction:column;min-height:0}
.side-brand{padding:14px 14px 10px}
.side-brand .name{font-size:15px;font-weight:600;letter-spacing:-.01em}
.side-brand .ver{font-size:11px;color:var(--ink-500);margin-top:2px}
.side-actions{padding:6px 10px 8px}
.newtask{display:flex;align-items:center;gap:10px;width:100%;padding:9px 12px;border:none;background:transparent;border-radius:var(--r-sm);font-size:13.5px;color:var(--ink-700);text-align:left}
.newtask:hover{background:var(--bg-hover)}
.newtask svg{width:15px;height:15px}
.side-nav{padding:0 10px}
.snav{display:flex;align-items:center;gap:10px;width:100%;padding:9px 12px;border:none;background:transparent;border-radius:var(--r-sm);font-size:13.5px;color:var(--ink-700);text-align:left}
.snav:hover{background:var(--bg-hover)}
.snav.active{background:var(--bg-active);color:var(--ink-900);font-weight:500}
.snav svg{width:15px;height:15px}
.sec-label{padding:14px 14px 6px;font-size:11.5px;font-weight:600;color:var(--ink-500);letter-spacing:.01em}
.proj{display:flex;align-items:center;gap:8px;width:100%;padding:7px 12px;border:none;background:transparent;border-radius:var(--r-sm);font-size:13px;color:var(--ink-600);text-align:left}
.proj:hover{background:var(--bg-hover)}
.proj .caret{width:12px;height:12px;flex:none;color:var(--ink-400);transition:transform .15s}
.proj.open .caret{transform:rotate(90deg)}
.proj .fold{width:15px;height:15px;color:var(--ink-500)}
.proj-leaf{padding:6px 12px 6px 42px;font-size:13px;color:var(--ink-700);border:none;background:transparent;width:100%;text-align:left;border-radius:var(--r-sm)}
.proj-leaf:hover{background:var(--bg-hover)}
.proj-leaf.active{background:var(--bg-active);color:var(--ink-900);font-weight:500}
.side-bottom{margin-top:auto;display:flex;align-items:center;gap:2px;padding:10px 12px;border-top:.5px solid var(--line)}
.sb-btn{width:34px;height:34px;border-radius:var(--r-sm);border:none;background:transparent;color:var(--ink-600);display:flex;align-items:center;justify-content:center}
.sb-btn:hover{background:var(--bg-hover)}
.sb-btn.active{color:var(--ink-900)}
.sb-btn svg{width:17px;height:17px}

/* ===== Main ===== */
.main{flex:1;min-width:0;display:flex;flex-direction:column;position:relative;background:var(--bg)}
.main-head{display:flex;align-items:center;gap:10px;padding:10px 18px;border-bottom:.5px solid var(--line)}
.main-head .crumb{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-600)}
.main-head .crumb b{color:var(--ink-900);font-weight:500}
.branch-pill{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border-radius:var(--r-pill);background:var(--bg-soft);border:.5px solid var(--line);font-size:12.5px;color:var(--ink-700)}
.branch-pill svg{width:13px;height:13px;color:var(--ink-500)}
.mh-spacer{flex:1}
.mh-right{display:flex;align-items:center;gap:10px}
.role-seg{display:flex;background:var(--bg-soft);border:.5px solid var(--line);border-radius:var(--r-pill);padding:2px}
.role-seg button{border:none;background:transparent;height:26px;padding:0 14px;border-radius:var(--r-pill);font-size:12.5px;color:var(--ink-600)}
.role-seg button.active{background:var(--dark);color:#fff}
.avt{width:30px;height:30px;border-radius:var(--r-pill);background:var(--blue);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:500}
.ai-chip{display:inline-flex;align-items:center;gap:5px;height:26px;padding:0 10px;border-radius:var(--r-pill);border:.5px solid var(--line);font-size:12px;color:var(--ink-600)}
.ai-chip b{font-weight:600}
.ai-chip .arrow{width:11px;height:11px;color:var(--ink-500)}

/* ===== Scroll region ===== */
.scroll{flex:1;min-height:0;overflow-y:auto}
.view{display:none;height:100%}
.view.active{display:flex;flex-direction:column}

/* ===== Home / greeting / input ===== */
.home{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 48px 120px;text-align:center}
.home-mark{width:64px;height:64px;margin-bottom:28px}
.home-mark svg{width:100%;height:100%}
.home-greet{font-size:30px;font-weight:500;letter-spacing:-.02em;color:var(--ink-900)}
.home-sub{font-size:14px;color:var(--ink-500);margin-top:12px}
.home-input-wrap{display:flex;flex-direction:column;align-items:center;width:100%;max-width:760px;margin-top:44px}
.home-input{width:100%;background:var(--bg);border:.5px solid var(--line-strong);border-radius:var(--r-xl);box-shadow:var(--shadow-md);padding:16px 18px;text-align:left;transition:border-color .15s}
.home-input:focus-within{border-color:var(--ink-900)}
.home-input textarea{width:100%;border:none;resize:none;outline:none;font-family:var(--font);font-size:15px;line-height:1.6;min-height:32px;background:transparent;color:var(--ink-900)}
.home-input textarea::placeholder{color:var(--ink-400)}
.home-toolbar{display:flex;align-items:center;gap:4px;margin-top:12px;padding-top:12px;border-top:.5px solid var(--line)}
.htool{width:34px;height:34px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;border:none;background:transparent;color:var(--ink-600)}
.htool:hover{background:var(--bg-hover)}
.htool svg{width:16px;height:16px}
.access-tag{display:inline-flex;align-items:center;gap:5px;height:28px;padding:0 11px;border-radius:var(--r-pill);background:var(--bg-soft);border:.5px solid var(--line);font-size:12px;color:var(--amber)}
.access-tag svg{width:13px;height:13px}
.home-toolbar .spacer{flex:1}
.model-pill{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border-radius:var(--r-pill);background:transparent;border:.5px solid var(--line);font-size:12.5px;color:var(--ink-700)}
.model-pill:hover{background:var(--bg-hover)}
.model-pill b{font-weight:500}
.model-pill .caret{width:12px;height:12px;color:var(--ink-500)}
.send-orb{width:34px;height:34px;border-radius:var(--r-pill);background:var(--bg-hover);color:var(--ink-600);display:flex;align-items:center;justify-content:center;border:none;transition:all .15s}
.send-orb:hover{background:var(--dark);color:#fff}
.send-orb svg{width:16px;height:16px}
.home-chips{display:flex;gap:8px;margin-top:20px;flex-wrap:wrap;justify-content:center}
.hchip{height:30px;padding:0 14px;border-radius:var(--r-pill);background:var(--bg-soft);border:.5px solid var(--line);font-size:13px;color:var(--ink-600)}
.hchip:hover{background:var(--bg-hover)}

/* ===== Import card / skill market cards ===== */
.mk-head{padding:22px 34px 0}
.mk-title{font-size:26px;font-weight:600;letter-spacing:-.02em}
.mk-sub{font-size:13.5px;color:var(--ink-500);margin-top:6px}
.mk-toolbar{display:flex;align-items:center;gap:8px;margin-top:16px}
.search-pill{display:flex;align-items:center;gap:8px;height:38px;min-width:200px;padding:0 14px;border-radius:var(--r-pill);background:var(--bg-soft);border:.5px solid var(--line)}
.search-pill input{border:none;background:transparent;outline:none;font-size:13.5px;width:100%;font-family:var(--font)}
.search-pill svg{width:15px;height:15px;color:var(--ink-500)}
.drop-pill{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 16px;border-radius:var(--r-pill);border:.5px solid var(--line);background:#fff;font-size:13.5px;color:var(--ink-700)}
.drop-pill:hover{background:var(--bg-soft)}
.drop-pill .caret{width:13px;height:13px;color:var(--ink-500)}
.icon-pill{width:38px;height:38px;border-radius:var(--r-pill);border:.5px solid var(--line);background:#fff;display:flex;align-items:center;justify-content:center;color:var(--ink-700)}
.icon-pill:hover{background:var(--bg-soft)}
.icon-pill svg{width:16px;height:16px}
.mk-body{padding:18px 34px 40px}
.mk-cat{margin-top:26px}
.mk-cat-name{font-size:17px;font-weight:600;letter-spacing:-.01em}
.mk-cat-desc{font-size:13px;color:var(--ink-500);margin-top:4px}
.mk-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}
.skill-card{position:relative;background:#fff;border:.5px solid var(--line);border-radius:var(--r-md);padding:16px 16px 16px;cursor:pointer;text-align:left;transition:border-color .15s,box-shadow .15s}
.skill-card:hover{border-color:var(--line-strong);box-shadow:var(--shadow-sm)}
.skill-card .sc-top{display:flex;align-items:center;gap:11px}
.skill-icon{width:38px;height:38px;border-radius:var(--r-sm);background:var(--dark);color:#fff;display:flex;align-items:center;justify-content:center;flex:none;font-weight:600;font-size:15px}
.skill-card .sc-title{font-size:14px;font-weight:600;text-align:left;line-height:1.3}
.skill-card .sc-desc{font-size:12.5px;color:var(--ink-500);margin-top:10px;line-height:1.55;text-align:left}
.check-orb{position:absolute;top:14px;right:14px;width:22px;height:22px;border-radius:var(--r-pill);background:var(--green-500);color:#fff;display:flex;align-items:center;justify-content:center}
.check-orb svg{width:12px;height:12px}

/* ===== Skill detail ===== */
.sd{padding:26px 48px 50px}
.sd-back{display:inline-flex;align-items:center;gap:6px;border:none;background:transparent;font-size:13px;color:var(--ink-600);margin-bottom:20px}
.sd-back:hover{color:var(--ink-900)}
.sd-back svg{width:14px;height:14px}
.sd-hero{display:flex;gap:16px;align-items:flex-start}
.sd-hero-icon{width:52px;height:52px;flex:none}
.sd-hero-icon svg{width:100%;height:100%}
.sd-tags{display:flex;gap:6px;align-items:center}
.tag{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:var(--r-pill);background:var(--bg-soft);border:.5px solid var(--line);font-size:12px;color:var(--ink-600)}
.tag.installed{background:var(--bg-hover);color:var(--ink-700)}
.sd-title{font-size:30px;font-weight:600;letter-spacing:-.02em;margin-top:10px}
.sd-desc{font-size:14.5px;line-height:1.7;color:var(--ink-700);margin-top:12px;max-width:640px}
.sd-author{font-size:12.5px;color:var(--ink-400);margin-top:8px}
.sd-sec{margin-top:34px}
.sd-sec-title{font-size:16px;font-weight:600}
.sd-sec-desc{font-size:13px;color:var(--ink-500);margin-top:4px}
.sd-list{margin-top:16px;border:.5px solid var(--line);border-radius:var(--r-md);overflow:hidden}
.sd-row{display:flex;align-items:center;gap:12px;padding:13px 16px;border-bottom:.5px solid var(--line)}
.sd-row:last-child{border-bottom:none}
.sd-row .r-icon{width:32px;height:32px;border-radius:var(--r-sm);background:var(--dark);color:#fff;display:flex;align-items:center;justify-content:center;flex:none;font-weight:600;font-size:14px}
.sd-row .r-main{flex:1;min-width:0}
.sd-row .r-name{font-size:13.5px;font-weight:500}
.sd-row .r-desc{font-size:12px;color:var(--ink-500);margin-top:2px}
.sd-row .r-tag{font-size:12px;color:var(--ink-600);background:var(--bg-soft);border:.5px solid var(--line);padding:4px 10px;border-radius:var(--r-pill)}

/* ===== Generic list rows (textbook / API / table) ===== */
.row-card{border:.5px solid var(--line);border-radius:var(--r-md);overflow:hidden}
.lrow{display:flex;align-items:center;gap:14px;padding:14px 18px;border-bottom:.5px solid var(--line)}
.lrow:last-child{border-bottom:none}
.lrow.hoverable:hover{background:var(--bg-soft)}
.lrow .li{width:38px;height:38px;border-radius:var(--r-sm);background:var(--bg-soft);display:flex;align-items:center;justify-content:center;color:var(--ink-700);flex:none}
.lrow .li svg{width:18px;height:18px}
.lrow .lm{flex:1;min-width:0}
.lrow .lm .t{font-size:14px;font-weight:500}
.lrow .lm .s{font-size:12.5px;color:var(--ink-500);margin-top:2px}
.lrow .side{display:flex;align-items:center;gap:6px}
.st-pill{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 12px;border-radius:var(--r-pill);background:var(--bg-soft);border:.5px solid var(--line);font-size:12px;color:var(--ink-600)}
.st-pill .dot{width:6px;height:6px;border-radius:var(--r-pill);background:var(--ink-400)}
.st-pill.green{background:var(--green-soft);color:var(--green);border-color:transparent}
.st-pill.green .dot{background:var(--green)}
.st-pill.amber{background:#ffedd5;color:var(--amber);border-color:transparent}
.st-pill.amber .dot{background:var(--orange)}
/* small pill buttons */
.pill-btn{height:30px;padding:0 14px;border-radius:var(--r-pill);border:.5px solid var(--line);background:#fff;font-size:12.5px;color:var(--ink-700);display:inline-flex;align-items:center;gap:5px}
.pill-btn:hover{background:var(--bg-soft)}
.pill-btn.dark{background:var(--dark);color:#fff;border-color:var(--dark)}
.pill-btn.ghost{border-color:transparent;background:var(--bg-hover)}
.pill-btn.orange{color:var(--orange);border-color:transparent;background:#fff}
.pill-btn.orange:hover{background:#fff7ed}
.pill-btn.danger{color:var(--red);border-color:transparent;background:#fff}
.pill-btn.danger:hover{background:#fef2f2}
.pill-btn svg{width:14px;height:14px}
/* generic action buttons in views (dark primary / ghost etc) */
.ghost-btn{height:32px;padding:0 12px;border-radius:var(--r-sm);border:none;background:var(--bg-soft);color:var(--ink-700);font-size:13px;display:inline-flex;align-items:center;gap:5px}
.ghost-btn:hover{background:var(--bg-hover)}
.ghost-btn svg{width:14px;height:14px}

/* ===== Section title rows ===== */
.view-sec{padding:22px 34px 0}
.view-h1{font-size:24px;font-weight:600;letter-spacing:-.02em}
.view-sub{font-size:13px;color:var(--ink-500);margin-top:6px}
.sec-h{margin-top:26px}
.sec-h h3{font-size:15px;font-weight:600}
.sec-h p{font-size:12.5px;color:var(--ink-500);margin-top:3px}

/* ===== Toggle switch ===== */
.switch{width:46px;height:26px;border-radius:var(--r-pill);background:var(--line-strong);position:relative;border:none;transition:background .18s;flex:none}
.switch::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:var(--r-pill);background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.2);transition:transform .18s}
.switch.on{background:var(--orange)}
.switch.on::after{transform:translateX(20px)}
.switch.blue.on{background:var(--blue)}

/* ===== Settings sections ===== */
.set-body{padding:22px 40px 60px;max-width:860px}
.set-body .close-x{position:absolute;top:18px;right:22px}
.set-h{font-size:26px;font-weight:600}
.set-h-sub{font-size:13px;color:var(--ink-500);margin-top:6px}
.set-card{margin-top:18px;border:.5px solid var(--line);border-radius:var(--r-md);overflow:hidden}
.set-row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 18px;border-bottom:.5px solid var(--line)}
.set-row:last-child{border-bottom:none}
.set-row .sl{display:flex;flex-direction:column;gap:3px}
.set-row .sl .t{font-size:14px;font-weight:500}
.set-row .sl .s{font-size:12.5px;color:var(--ink-500)}
.set-row .sr{display:flex;align-items:center;gap:10px}
.text-input{height:34px;padding:0 12px;border:.5px solid var(--line-strong);border-radius:var(--r-sm);font-size:13px;font-family:var(--font);color:var(--ink-900);outline:none;min-width:200px}
.text-input:focus{border-color:var(--ink-900)}
.seg{display:flex;background:var(--bg-soft);border:.5px solid var(--line);border-radius:var(--r-pill);padding:2px}
.seg button{border:none;background:transparent;height:26px;padding:0 14px;border-radius:var(--r-pill);font-size:12.5px;color:var(--ink-600)}
.seg button.active{background:#fff;color:var(--ink-900);box-shadow:var(--shadow-sm)}
/* API connection cards */
.api-card{border:.5px solid var(--line);border-radius:var(--r-md);padding:14px 18px;margin-top:10px}
.api-card.active{background:#fef2f2;border-color:#fecaca}
.api-card .toprow{display:flex;align-items:center;justify-content:space-between}
.api-card .name{font-size:14px;font-weight:600}
.api-card .name .enable-dot{display:inline-block;width:8px;height:8px;border-radius:var(--r-pill);background:var(--orange);margin-left:8px}
.api-card .meta{font-size:12.5px;color:var(--ink-500);margin-top:3px}
.api-card .acts{display:flex;align-items:center;gap:6px}
.newapi{display:flex;align-items:center;gap:12px;margin-top:14px;padding:4px 2px}
.newapi .plus-orb{width:38px;height:38px;border-radius:var(--r-pill);border:.5px solid var(--line);background:#fff;display:flex;align-items:center;justify-content:center;color:var(--ink-700)}
.newapi .plus-orb:hover{background:var(--bg-soft)}
.newapi .lbl{font-size:14px;font-weight:500}
/* git graph */
.git-graph{width:100%;border-collapse:collapse;font-size:13px}
.git-graph th{text-align:left;font-weight:500;color:var(--ink-500);font-size:12px;padding:10px 14px;border-bottom:.5px solid var(--line)}
.git-graph td{padding:10px 14px;border-bottom:.5px solid var(--line);vertical-align:middle}
.git-graph td.g-col{width:40px}
.graph-line{display:flex;align-items:center;gap:6px}
.gdot{width:8px;height:8px;border-radius:var(--r-pill);background:#fff;border:2px solid var(--blue);flex:none}
.gdot.gray{border-color:var(--ink-400)}
.tag-pill{font-size:11px;background:var(--bg-hover);border:.5px solid var(--line);padding:2px 8px;border-radius:var(--r-pill);color:var(--ink-600)}
.diff-pos{color:var(--green)} .diff-neg{color:var(--red)}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;color:var(--ink-500)}

/* ===== Popover / modal ===== */
.pop{position:absolute;background:#fff;border:.5px solid var(--line);border-radius:var(--r-md);box-shadow:var(--shadow-md);z-index:60;overflow:hidden}
.pop-head{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:.5px solid var(--line)}
.pop-head .ttl{font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:7px}
.pop-head .ttl svg{width:15px;height:15px}
.pop-body{padding:6px}
.git-item{display:flex;align-items:center;gap:10px;width:100%;padding:10px 12px;border:none;background:transparent;border-radius:var(--r-sm);font-size:13.5px;color:var(--ink-800);text-align:left}
.git-item:hover{background:var(--bg-hover)}
.git-item svg{width:15px;height:15px;color:var(--ink-500)}
.git-item .gt{flex:1}
.git-item .diff{font-size:12px}
.git-item .chev{width:13px;height:13px;color:var(--ink-400)}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.28);z-index:80;display:flex;align-items:center;justify-content:center;padding:24px}
.modal{width:100%;max-width:520px;max-height:86vh;overflow:auto;background:#fff;border-radius:var(--r-lg);box-shadow:var(--shadow-md);padding:22px 24px}
.modal .m-title{font-size:16px;font-weight:600}
.modal .m-sub{font-size:12.5px;color:var(--ink-500);margin-top:4px}
.modal .m-close{position:absolute;top:18px;right:18px}
.modal.m-wide{max-width:900px}
.m-branch{display:flex;align-items:center;justify-content:space-between;margin-top:16px;border:.5px solid var(--line);border-radius:var(--r-sm);padding:10px 14px}
.m-branch .diff{font-size:12px}
.m-label{font-size:12px;color:var(--ink-500);margin-top:16px}
.m-area{margin-top:8px;position:relative}
.m-area textarea{width:100%;height:130px;border:.5px solid var(--line-strong);border-radius:var(--r-sm);padding:10px 34px 10px 12px;font-size:13px;font-family:var(--font);resize:none;outline:none}
.m-area textarea:focus{border-color:var(--ink-900)}
.m-area .gen{position:absolute;top:10px;right:10px;width:22px;height:22px;border:none;background:transparent;color:var(--ink-500)}
.m-area .gen svg{width:14px;height:14px}
.m-check{display:flex;align-items:center;justify-content:space-between;margin-top:14px;font-size:13px;color:var(--ink-700)}
.m-check .ck{display:flex;align-items:center;gap:8px}
.m-foot{display:flex;justify-content:flex-end;gap:8px;margin-top:22px}

/* ===== Side panel (right quadrant) ===== */
.sidepanel{width:300px;flex:none;border-left:.5px solid var(--line);background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px}
.sp-title{font-size:15px;font-weight:600}
.sp-sub{font-size:12.5px;color:var(--ink-500);margin-top:4px}
.quad{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:26px}
.qbtn{width:76px;height:76px;border-radius:var(--r-pill);border:.5px solid var(--line);background:transparent;color:var(--ink-800);display:flex;align-items:center;justify-content:center;position:relative}
.qbtn:hover{background:var(--bg-soft)}
.qbtn svg{width:22px;height:22px}
.qbtn .qb-tag{position:absolute;top:-6px;right:-6px;width:20px;height:20px;border-radius:var(--r-pill);background:var(--blue);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600}
.qbtn.fill{background:var(--blue);color:#fff;border-color:var(--blue)}

/* small buttons inside content */
.icon-ghost{width:28px;height:28px;border-radius:var(--r-sm);border:none;background:transparent;color:var(--ink-500);display:inline-flex;align-items:center;justify-content:center}
.icon-ghost:hover{background:var(--bg-hover);color:var(--ink-900)}
.icon-ghost svg{width:15px;height:15px}
</style>
</head>
<body>
<div class="win">

  <!-- ===== Title tabs ===== -->
