        </button>
        <button class="snav" data-view="lesson" data-ro="student">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12l-10-7L2 12l10 7 10-7z"/><path d="M6 13v5l6 4 6-4v-5"/></svg>
