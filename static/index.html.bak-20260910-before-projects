  /* ==== Git 工具 popover ==== */
  document.getElementById('avat').addEventListener('click', function(){ openGitPop(); });
  var gitPop = null;
  function openGitPop(){
    if(gitPop){ gitPop.remove(); gitPop=null; return; }
    gitPop = document.createElement('div');
    gitPop.className='pop';
    gitPop.style.top='66px';gitPop.style.right='220px';gitPop.style.width='300px';
    gitPop.innerHTML = '<div class="pop-head"><div class="ttl"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h10M4 18h7"/></svg>Git 工具</div><button class="icon-ghost" style="width:26px;height:26px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v4h-4"/></svg></button></div>'+
      '<div class="pop-body">'+
        '<button class="git-item" data-g="commit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4H6.5A2.5 2.5 0 0 0 4 6.5v13z"/></svg><span class="gt">更改</span><span class="diff"><span class="diff-pos">+19466</span> <span class="diff-neg">-12857</span></span></button>'+
