# ============ 密钥与环境（绝不入库） ============
.env

# ============ 虚拟环境 / 缓存 ============
.venv/
__pycache__/
*.pyc
.uv-cache/
.hf-cache/
.idea/

# ============ 运行时数据（可再生的本地产物，不入库） ============
data/
logs/
content/plans/
content/raw/
# 删除的模板软删到这里（带时间戳，可手工找回）——是老师的数据，不入库
content/templates/_trash/
model_cache/

# ============ 教材知识库说明 ============
# chroma_db/ 与 content/structured_auto/ 已入库：
# content/structured_auto/*.md = 教材自动切节文本（向量化源）
# chroma_db/ = 预建向量库（151 块，可直接检索；也可按 README 重建）

# ============ 前端备份文件（不入库） ============
static/*.bak-*
*.bak-*

# ============ 第三方 WPS MCP（wps-skills）：绝不入库 ============
# 交接约定见 docs/09-WPS接入交接要求.md：第三方源码/node_modules 会让仓库爆掉，
# 一律由 deploy/setup_wps_mcp.cmd 克隆到仓库外（默认 %LOCALAPPDATA%\edu-agent\deps\wps-skills），
# 应用侧按 WPS_MCP_DIR / data/wps_mcp.json 解析路径。下面两行是防回流护栏，别删。
mcp_servers/wps-office-mcp/
skills/
